# Copy to .env (never commit it).
PITBOSS_SOURCE=http
PITBOSS_HOST=192.168.1.50
PITBOSS_MODEL=PB850PS2
PITBOSS_PASSWORD=
SMOKESTACK_POLL_SECONDS=2
# Bluetooth only: the adapter to use when the host has more than one
# (`bluetoothctl list`). Empty uses the system default.
# SMOKESTACK_BLE_ADAPTER=hci1
# SMOKESTACK_PORT=8000
# The dashboard password isn't set here: the first visit asks you to create
# one, and Settings can turn it off or change it.
